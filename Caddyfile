wentongzhang.com {
	redir https://www.wentongzhang.com{uri} permanent
}

www.wentongzhang.com {
	root * /srv
	file_server
	encode gzip

	# Serve Astro's generated directories, with the homepage as a final fallback.
	try_files {path} {path}/ /index.html

	# Revalidate generated HTML so publishing a new build is visible promptly.
	@html path / *.html */
	header @html Cache-Control "no-cache"

	# Astro fingerprints build assets; long-lived caching is safe for those files.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path /assets/* /scripts/*
	header @static Cache-Control "public, max-age=3600"
}

import /etc/caddy/app-routes/*.caddy
